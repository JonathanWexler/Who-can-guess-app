{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The worker name becomes the URL: https://<name>.<your-account>.workers.dev
  "name": "guess",
  "account_id": "ca137ae942b964de04a24d0b41bfe52f",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  // The web pages in public/ are packed into the Worker before each build.
  "build": { "command": "node scripts/bundle-pages.js", "watch_dir": "public" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "observability": { "enabled": true }
}
